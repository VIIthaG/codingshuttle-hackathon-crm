# FlowCRM frontend environment example.
# Copy to `.env` for local overrides (`.env` is gitignored).

# Backend origin used by fetch() in src/api/client.ts.
#
# Local development (recommended):
#   Leave empty so requests stay same-origin (/api/...) and Vite proxies
#   /api -> http://localhost:8080 (see vite.config.ts). No CORS changes needed.
#
# Deployed SPA:
#   Set the public backend base URL with no trailing slash, for example:
#   VITE_API_BASE_URL=https://your-api.example.com
#
# Do NOT put JWT signing secrets, DB passwords, or other backend secrets here.
# Do not commit real production URLs if your team treats them as private.
VITE_API_BASE_URL=
