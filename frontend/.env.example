# FlowCRM frontend local/dev environment example.
# Copy to `.env` for local overrides (`.env` is gitignored).

# API origin for fetch().
# - Leave empty in local Vite: requests go to the same origin and are proxied to Spring Boot
#   (see vite.config.ts → proxy `/api` → http://localhost:8080).
# - For a deployed SPA, set the public backend URL, e.g. https://your-api.example.com
# Do NOT put JWT signing secrets here.
VITE_API_BASE_URL=
